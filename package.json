{
  "name": "dsh-eval",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:security": "npm audit --audit-level=high --fetch-retries=1 --fetch-timeout=60000",
    "test:deep-research": "npm --prefix evals/deep-research test",
    "eval:deep-research": "node evals/deep-research/src/run.mjs",
    "test:search": "npm --prefix evals/search test",
    "eval:search": "npm --prefix evals/search start --",
    "test:memory": "npm --prefix evals/memory test",
    "eval:memory": "npm --prefix evals/memory start --"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "sharp": "0.35.4",
    "ws": "8.21.3",
    "undici": "7.29.0",
    "esbuild": "0.28.1"
  },
  "type": "module"
}
