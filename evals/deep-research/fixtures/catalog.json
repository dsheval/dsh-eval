{
  "id": "dsh-deep-research-catalog-v2",
  "profile": "research-eval",
  "port": 3280,
  "baseline": {
    "id": "C0",
    "plugin": "none",
    "fullName": null,
    "install": { "kind": "none" },
    "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
    "optionalCredentialRefs": [],
    "platforms": ["win32", "linux", "darwin"],
    "focus": "DSH 默认能力，不安装额外 Deep Research 插件"
  },
  "plugins": [
    {
      "id": "P1",
      "plugin": "hanai-investment-dsh",
      "fullName": "hancao97/hanai-investment-dsh",
      "upstreamAlias": "hanai-labs/worth-dsh",
      "install": {
        "kind": "source-profile",
        "rootEnv": "DSH_RESEARCH_EVAL_DEPS",
        "relativePath": "sources/worth-dsh",
        "artifact": "lib/install-profile.js",
        "reason": "官方流程要求源码构建并创建专用 hanai-investment Profile"
      },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "runtimeChecks": ["node-24", "dsh-0.1.1-rc.2"],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "投研工作台、版本化报告与数据追溯"
    },
    {
      "id": "P2",
      "plugin": "dsh-science",
      "fullName": "biociao/dsh-science",
      "install": { "kind": "dsh-add", "spec": "dsh-science" },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "研究循环、版本化数据与科研产物"
    },
    {
      "id": "P3",
      "plugin": "dsh-scholar",
      "fullName": "lzszq/dsh-scholar",
      "install": {
        "kind": "source-add",
        "rootEnv": "DSH_RESEARCH_EVAL_DEPS",
        "relativePath": "sources/dsh-scholar",
        "artifact": "lib/index.js",
        "verifyPlugin": "@dsh-scholar/research-plugin",
        "reason": "包尚未发布；官方流程要求源码构建、Linux、Node 24、pnpm 11 和 Docker"
      },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "runtimeChecks": ["node-24", "dsh-0.1.1-rc.2", "docker-engine"],
      "platforms": ["linux"],
      "focus": "可恢复科研项目、证据账和受控实验"
    },
    {
      "id": "P4",
      "plugin": "dsh-deep-research",
      "fullName": "omdsh-dev/dsh-deep-research",
      "install": {
        "kind": "source-add",
        "rootEnv": "DSH_RESEARCH_EVAL_DEPS",
        "relativePath": "sources/dsh-deep-research",
        "artifact": "dist/dsh-external-dsh-deep-research-0.1.0.tgz",
        "useArtifactAsSpec": true,
        "verifyPlugin": "@dsh-external/dsh-deep-research",
        "reason": "上游插件使用旧 workflows 服务名；本地源码兼容层对齐 DSH 0.1.1-rc.2 的 workflowEngine 服务"
      },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "runtimeChecks": ["node-24", "dsh-0.1.1-rc.2"],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "自适应研究闭环与中间状态恢复"
    },
    {
      "id": "P5",
      "plugin": "dsh-search-boost",
      "fullName": "Mr-remon219/dsh-search-boost",
      "install": { "kind": "dsh-add", "spec": "dsh-search-boost" },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [
        "TAVILY_API_KEY",
        "EXA_API_KEY",
        "BRAVE_API_KEY",
        "XAI_API_KEY"
      ],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "多引擎检索与多步研究；报告必须注明实际启用的搜索层"
    },
    {
      "id": "P6",
      "plugin": "dsh-deepresearch",
      "fullName": "havingautism/dsh-deepresearch",
      "install": {
        "kind": "dsh-add",
        "spec": "github:havingautism/dsh-deepresearch"
      },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "子问题、证据、覆盖度和完整报告闭环"
    },
    {
      "id": "P7",
      "plugin": "dsh-ai4scholar",
      "fullName": "literaf/dsh-ai4scholar",
      "evaluation": {
        "enabled": false,
        "reason": "本轮不提供 AI4SCHOLAR_API_KEY，按用户决定排除，不计零分且不进入榜单"
      },
      "install": { "kind": "dsh-add", "spec": "dsh-ai4scholar" },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY", "AI4SCHOLAR_API_KEY"],
      "optionalCredentialRefs": [],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "论文、全文、引用和学术来源"
    },
    {
      "id": "P8",
      "plugin": "dsh-science-workbench",
      "fullName": "poplarity/dsh-science-workbench",
      "install": { "kind": "dsh-add", "spec": "dsh-science-workbench" },
      "requiredCredentialRefs": ["DEEPSEEK_API_KEY"],
      "optionalCredentialRefs": [],
      "platforms": ["win32", "linux", "darwin"],
      "focus": "单元格、图表、环境快照和可复现实验"
    }
  ]
}
