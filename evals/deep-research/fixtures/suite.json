  "description": "校准版：5 个测评项保持短事实、长报告、产品诊断 2:2:1 分布；按轨限制搜索扩张和研究型工具调用，为长文保留综合阶段，并自动重试可识别的模型基础设施错误。",
  "selection": {
    "policy": "balanced-compact-no-search-cap-v1",
    "shortFact": { "xbench-deepsearch.2505": 1, "browsecomp-zh.test": 1 },
    "longForm": { "deepresearcheval.v1": 2 },
    "productDiagnostics": 1,
    "officialAndDiagnosticMetricsStaySeparate": true
  },
  "execution": {
    "taskTimeoutMs": null,
    "installTimeoutMs": 600000,
    "interruptAfterMs": 45000,
    "urlCheckLimit": 20,
    "budgetPollIntervalMs": 10000,
    "infrastructureRetries": 2,
    "infrastructureRetryDelayMs": 5000,
    "researchProtocol": {
      "id": "bounded-evidence-v1",
      "maxSubagents": 4,
      "sourcesPerDeliverable": 2,
      "maxSearchCalls": 20,
      "synthesisReserveCalls": 12,
      "instructions": [
        "Before searching, map every required deliverable to a bounded evidence question.",
        "Create at most four subagents and partition their scopes so they do not run the same searches.",
        "Do not submit the same normalized search query more than twice across the parent and child sessions.",
        "Stop expanding a deliverable after it has two credible independent sources, unless those sources materially conflict.",
        "Use automatic subagent completion notifications; do not repeatedly call list_agents while work is still running.",
        "Write the final report and supporting artifacts inside the current working directory, then always provide a final chat answer."
      ]
    },
    "budgets": {
      "SF": {
        "maxSearchCalls": 12,
        "maxToolCalls": null,
        "maxBudgetedCalls": 40,
        "maxQueryRepeats": 2,
        "noProgressMs": 120000
      },
      "LF": {
        "maxSearchCalls": 24,
        "maxToolCalls": null,
        "maxBudgetedCalls": 72,
        "maxQueryRepeats": 2,
        "noProgressMs": 240000
      },
      "PRODUCT": {
        "maxSearchCalls": null,
        "maxToolCalls": null,
        "maxBudgetedCalls": 60,
        "maxQueryRepeats": 2,
        "noProgressMs": 600000
      }
    },
    "stabilityTasks": ["R1", "R6", "R7"],
    "stabilityRepeats": 2
  },
  "judge": {
    "enabledByDefault": true,
    "provider": "openai-compatible",
    "baseUrl": "https://api.deepseek.com/chat/completions",
    "apiKeyEnv": "DEEPSEEK_API_KEY",
    "modelEnv": "DSH_RESEARCH_JUDGE_MODEL",
