{
  "$comment": "单题记录。meta.json 在同目录，描述整轮条件。",
  "type": "object",
  "required": ["taskId", "answer", "answerResult", "process", "secondary"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^(T[1-8]|L[0-9]{2})$" },
    "protocol": { "enum": ["passive", "guided", "session-reference", null] },
    "install": { "enum": ["成功", "失败", null] },
    "start": { "enum": ["成功", "失败", null] },
    "barrier": { "enum": ["close-session", "switch-workspace", "kill-dsh", null] },
    "answer": { "type": "string", "description": "会话 B 的回答要点，不要贴记忆库原文" },
    "answerResult": { "enum": ["成功", "失败", "部分", null] },
    "answerReason": { "type": ["string", "null"] },
    "process": {
      "type": "object",
      "properties": {
        "injectedTokens": { "type": ["number", "null"] },
        "extraModelCalls": { "type": ["number", "null"] },
        "seedToolCalls": { "type": ["number", "null"] },
        "probeToolCalls": { "type": ["number", "null"] },
        "totalToolCalls": { "type": ["number", "null"] },
        "seedToolCalls": { "type": ["number", "null"] },
        "probeToolCalls": { "type": ["number", "null"] },
        "totalToolCalls": { "type": ["number", "null"] },
        "latencyMs": { "type": ["number", "null"] },
        "retrievedCount": { "type": ["number", "null"] },
        "injectedCount": { "type": ["number", "null"] },
        "seedInjectedCount": { "type": ["number", "null"] },
        "probeInjectedCount": { "type": ["number", "null"] },
        "totalInjectedCount": { "type": ["number", "null"] },
        "seedInjectedCount": { "type": ["number", "null"] },
        "probeInjectedCount": { "type": ["number", "null"] },
        "totalInjectedCount": { "type": ["number", "null"] },
        "dumpedAllNoise": { "type": ["boolean", "null"] },
        "seedEchoCount": { "type": ["number", "null"] },
        "seedCount": { "type": ["number", "null"] },
        "foreignEchoCount": { "type": ["number", "null"] }
      }
    },
    "secondary": { "enum": ["未做", "强迫写入后能召回", "仍不能", "要审批"] },
    "notes": { "type": "string" },
    "confidence": { "enum": ["高", "中", "低", "暂不推荐", ""] }
  }
}
